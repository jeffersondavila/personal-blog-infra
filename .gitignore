# ---------------------------------------------------------------------------
# personal-blog-infra — .gitignore
# ---------------------------------------------------------------------------

# Secretos y configuración local
.env
.env.*
!.env.example
*.env
secrets/
*.pem
*.key
*.crt
*.pfx
*.p12
credentials
credentials.json

# Terraform (uso futuro)
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
tfplan
*.tfplan

# Datos y volúmenes locales
data/
volumes/
backups/
dumps/
*.dump
*.sql.gz

# Conjuntos de respaldo locales (Task/004)
# Contienen datos reales del blog y la configuración de Portainer, incluidos
# hashes de autenticación. NUNCA se versionan.
local-backups/
*.tar.gz
!docs/**/*.tar.gz.example

# Logs
logs/
*.log

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Temporales
tmp/
temp/
*.tmp
*.bak
*.orig
