; personal-blog-infra
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.{tf,tfvars,hcl}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2
end_of_line = lf

[*.{ps1,psm1}]
indent_size = 4
end_of_line = crlf

[Makefile]
indent_style = tab

[*.py]
indent_size = 4

[{Dockerfile,Dockerfile.*,*.dockerfile}]
indent_size = 2
