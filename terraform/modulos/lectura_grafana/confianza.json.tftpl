{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GrafanaCloudConExternalId",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::${cuenta_de_grafana}:root"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "${external_id}"
        }
      }
    }
  ]
}
