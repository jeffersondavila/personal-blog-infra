# ---------------------------------------------------------------------------
# personal-blog-infra — Variables del entorno local (ejemplo)
#
# Copia este archivo a `.env` y ajusta los valores:
#
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
#
# `.env` esta ignorado por Git. Este archivo `.env.example` SI se versiona y
# por tanto NO puede contener credenciales reales: todos los valores de abajo
# son ficticios y solo sirven para el entorno local de desarrollo.
#
# Regla del proyecto (CONTRIBUTING.md, seccion 5): los valores sensibles se
# documentan como nombres de variable, nunca como valores reales.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------

# Prefijo de contenedores, redes y volumenes. Cambialo si ejecutas varias
# copias del entorno en la misma maquina.
COMPOSE_PROJECT_NAME=personal-blog-local

# Zona horaria de los contenedores. El proyecto almacena fechas en UTC
# (docs/architecture/api-contracts.md), asi que UTC es el valor correcto.
TZ=UTC

# Interfaz en la que se publican los puertos.
# 127.0.0.1 = solo esta maquina. NO lo cambies a 0.0.0.0: expondria
# PostgreSQL, MinIO y Portainer a la red local.
LOCAL_BIND_ADDRESS=127.0.0.1

# --- PostgreSQL ------------------------------------------------------------

# Version de parche completa: `17-alpine` es una etiqueta movil dentro de la
# serie 17 y cambiaria de parche sin aviso.
POSTGRES_VERSION=17.11-alpine@sha256:18cfe3ef5e6815560c98237d6216d1e5119702fb0f3894c8785dd58b8bbe5d73
POSTGRES_DB=personal_blog
POSTGRES_USER=blog_local
# Ficticia. Valida solo para desarrollo local. Cambiala en tu `.env`.
POSTGRES_PASSWORD=change-me-local-postgres

# Puerto en el host. Se usa 55432 y no 5432 para no chocar con otras
# instancias de PostgreSQL ya instaladas o con otros proyectos Docker.
POSTGRES_HOST_PORT=55432
# /tmp del contenedor, en RAM: archivos temporales del propio PostgreSQL.
# El volcado de respaldo NO se escribe aqui, sino en el volumen /backup:
# `docker cp` no sabe leer de un tmpfs (runbook, seccion 2 - Volumenes).
POSTGRES_BACKUP_TMP_SIZE=128m

# --- MinIO (almacenamiento compatible con S3) ------------------------------

MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
MINIO_ROOT_USER=blog_minio_local
# Ficticia. MinIO exige al menos 8 caracteres. Cambiala en tu `.env`.
MINIO_ROOT_PASSWORD=change-me-local-minio

# API S3 y consola web.
MINIO_API_HOST_PORT=9000
# /tmp del contenedor, en RAM: alberga la configuracion efimera de `mc`.
# El arbol de objetos del respaldo se prepara en el volumen /backup, no aqui.
# Se reserva capacidad, no se asigna toda esta RAM al arrancar.
MINIO_BACKUP_TMP_SIZE=512m

# --- Almacenamiento de objetos del backend (`Task/010`) --------------------
#
# El backend depende de la interfaz `ObjectStorage`; estas variables solo
# ajustan el destino local. Task018 separa las credenciales runtime: ejecutar
# scripts/security/runtime_privileges.py --apply con el venv del backend.
# El resultado vive en secrets/backend-runtime.env, ignorado; nunca se usan
# las credenciales root de arriba dentro del backend.
#
# El bucket NO lo crea el backend: crear buckets es infraestructura. En local se
# crea una vez desde la consola de MinIO o con `mc` (runbook del entorno local);
# en produccion lo crea Terraform (`Task/030`).
BLOG_STORAGE_BUCKET=personal-blog-media
BLOG_STORAGE_REGION=us-east-1

# El endpoint de ACCESO del backend se deriva del Compose como
# `http://localhost:${MINIO_API_HOST_PORT}` y NO se configura aqui: es el
# anfitrion que el navegador del host usa para descargar una imagen, distinto
# del `minio:9000` con el que el backend opera. Cambiar MINIO_API_HOST_PORT
# ajusta los dos a la vez.

# Validez del enlace temporal de una imagen, en segundos (60..604800).
# La politica de expiracion definitiva de produccion es de `Task/030` (D-08).
BLOG_STORAGE_ACCESS_TTL_SECONDS=900
MINIO_CONSOLE_HOST_PORT=9001

# --- Aplicaciones (Task/007) -----------------------------------------------
#
# Rutas al contexto de construccion de cada aplicacion, relativas a esta
# carpeta. Suponen que los tres repositorios estan clonados como carpetas
# hermanas, que es la disposicion documentada del workspace (riesgo R-05).
BACKEND_CONTEXT=../personal-blog-backend
FRONTEND_CONTEXT=../personal-blog-frontend

# Configuracion del backend dentro del Compose. La URL de la base de datos NO
# se define aqui: procede de secrets/backend-runtime.env, con rol limitado.
# POSTGRES_USER/PASSWORD quedan reservados para bootstrap, migraciones y backup.
BLOG_APP_NAME=personal-blog-backend
BLOG_LOG_LEVEL=INFO

# --- Traefik v3 (reverse proxy local, D-05) ---------------------------------

# Version fija: `v3` es una etiqueta movil dentro de la serie 3.
TRAEFIK_VERSION=v3.7.13@sha256:f86a2cab1b5c649070c49f883c743dd32d8485a56e3368c5f93b9e91f1e91259

# Unico puerto publicado de las aplicaciones. Sirve el SITIO y el API en el
# mismo origen: el navegador trata las peticiones como same-origin y no hace
# falta CORS.
#
# 8081 y no 80 ni 8080: 80 exige privilegios en algunas maquinas y 8080 choca
# con otros proyectos Docker habituales. Si lo cambias, actualiza tambien
# VITE_API_BASE_URL en personal-blog-frontend y reconstruye su imagen: Vite
# incrusta esa variable en tiempo de BUILD.
TRAEFIK_HTTP_HOST_PORT=8081

# --- Portainer CE (solo local) ---------------------------------------------

PORTAINER_VERSION=2.39.7@sha256:0e3c8bc8c50aa69a21d024bf2822b6c49a107e5591573b93951191c3fcffbe02
# 9444 en lugar del 9443 habitual, para no chocar con otra instancia de
# Portainer que ya este corriendo en la maquina.
PORTAINER_HTTPS_HOST_PORT=9444
