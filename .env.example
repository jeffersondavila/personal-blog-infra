# ---------------------------------------------------------------------------
# personal-blog-infra — Variables del entorno local (ejemplo)
#
# Copia este archivo a `.env` y ajusta los valores:
#
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
#
# `.env` esta ignorado por Git. Este archivo `.env.example` SI se versiona y
# por tanto NO puede contener credenciales reales: todos los valores de abajo
# son ficticios y solo sirven para el entorno local de desarrollo.
#
# Regla del proyecto (CONTRIBUTING.md, seccion 5): los valores sensibles se
# documentan como nombres de variable, nunca como valores reales.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------

# Prefijo de contenedores, redes y volumenes. Cambialo si ejecutas varias
# copias del entorno en la misma maquina.
COMPOSE_PROJECT_NAME=personal-blog-local

# Zona horaria de los contenedores. El proyecto almacena fechas en UTC
# (docs/architecture/api-contracts.md), asi que UTC es el valor correcto.
TZ=UTC

# Interfaz en la que se publican los puertos.
# 127.0.0.1 = solo esta maquina. NO lo cambies a 0.0.0.0: expondria
# PostgreSQL, MinIO y Portainer a la red local.
LOCAL_BIND_ADDRESS=127.0.0.1

# --- PostgreSQL ------------------------------------------------------------

# Version de parche completa: `17-alpine` es una etiqueta movil dentro de la
# serie 17 y cambiaria de parche sin aviso.
POSTGRES_VERSION=17.10-alpine
POSTGRES_DB=personal_blog
POSTGRES_USER=blog_local
# Ficticia. Valida solo para desarrollo local. Cambiala en tu `.env`.
POSTGRES_PASSWORD=change-me-local-postgres

# Puerto en el host. Se usa 55432 y no 5432 para no chocar con otras
# instancias de PostgreSQL ya instaladas o con otros proyectos Docker.
POSTGRES_HOST_PORT=55432

# --- MinIO (almacenamiento compatible con S3) ------------------------------

MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=blog_minio_local
# Ficticia. MinIO exige al menos 8 caracteres. Cambiala en tu `.env`.
MINIO_ROOT_PASSWORD=change-me-local-minio

# API S3 y consola web.
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- Portainer CE (solo local) ---------------------------------------------

PORTAINER_VERSION=2.39.5
# 9444 en lugar del 9443 habitual, para no chocar con otra instancia de
# Portainer que ya este corriendo en la maquina.
PORTAINER_HTTPS_HOST_PORT=9444
